# ==============================================================================
# Maqam Travels Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API Base URL (Local development or Production HTTPS)
VITE_API_BASE_URL=http://localhost:5000

# Proxy target for Vite dev-server
VITE_PROXY_TARGET=http://localhost:5000

# Route through local dev proxy (set true to eliminate CORS preflight locally)
VITE_USE_DEV_API_PROXY=false

# AI Planner API Endpoint
VITE_AI_API_URL=http://localhost:5000

# Force mock API data for CRM modules (false = live backend)
VITE_USE_MOCK_API=false
